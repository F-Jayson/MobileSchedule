<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_2x2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamic Background Layer with Rounded Corners & Opacity Tinting -->
    <ImageView
        android:id="@+id/widget_2x2_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget"
        android:contentDescription="@null" />

    <!-- Foreground Content -->
    <LinearLayout
        android:id="@+id/widget_2x2_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Status Pill Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_2x2_header_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_today"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_2x2_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_widget_pill"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="下一节课"
                android:textSize="11sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_2x2_header_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="第 7 周"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Divider Line -->
        <ImageView
            android:id="@+id/widget_2x2_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/widget_divider"
            android:contentDescription="@null" />

        <!-- Middle Focus Course Area -->
        <LinearLayout
            android:id="@+id/widget_2x2_course_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_2x2_course_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="课程名称"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_2x2_time_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="08:20 - 10:00 (第1-2节)"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_2x2_location_teacher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="理科楼 101 · 王教授"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Empty / Finished State Area -->
        <LinearLayout
            android:id="@+id/widget_2x2_empty_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_2x2_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="今日课程已结束"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_2x2_empty_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="明日首节：面向对象 (08:20)"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Bottom Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_2x2_date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10月19日 周一"
                android:textSize="11sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_2x2_launch_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_widget_launch"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

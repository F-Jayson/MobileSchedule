<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamic Background Layer with Rounded Corners & Opacity Tinting -->
    <ImageView
        android:id="@+id/widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget"
        android:contentDescription="@null" />

    <!-- Foreground Content -->
    <LinearLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_header_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_schedule"
                android:tint="@color/widget_accent"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_header_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="10月15日 周四"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary" />

            <LinearLayout
                android:id="@+id/widget_header_week_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_widget_pill"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/widget_header_week"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="第 7 周"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_accent" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日剩余课程"
                android:textSize="11sp"
                android:textColor="@color/widget_text_secondary" />

            <ImageView
                android:id="@+id/widget_header_launch_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_widget_launch"
                android:tint="@color/widget_text_secondary"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Divider Line -->
        <ImageView
            android:id="@+id/widget_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/widget_divider"
            android:contentDescription="@null" />

        <!-- Content Area: Courses or Empty State -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Scrollable Courses ListView (Used for All Courses mode with scrolling) -->
            <ListView
                android:id="@+id/widget_courses_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:fadingEdge="none"
                android:cacheColorHint="@android:color/transparent"
                android:listSelector="@android:color/transparent"
                android:visibility="gone" />

            <!-- Upcoming Courses List (up to 3 items + more row) -->
            <LinearLayout
                android:id="@+id/widget_courses_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="top">

                <!-- Course Row 1 -->
                <LinearLayout
                    android:id="@+id/widget_course_row_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/widget_course_badge_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_widget_badge_normal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="第1-2节"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_badge_normal_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_course_title_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="高等数学"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/widget_text_primary"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/widget_course_info_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="08:00 - 09:35 · 知明 1-101"
                            android:textSize="11sp"
                            android:textColor="@color/widget_text_secondary"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Course Row 2 -->
                <LinearLayout
                    android:id="@+id/widget_course_row_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/widget_course_badge_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_widget_badge_normal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="第3-4节"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_badge_normal_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_course_title_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="大学物理"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/widget_text_primary"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/widget_course_info_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="10:00 - 11:35 · 知明 2-203"
                            android:textSize="11sp"
                            android:textColor="@color/widget_text_secondary"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Course Row 3 (Optional 3rd row) -->
                <LinearLayout
                    android:id="@+id/widget_course_row_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/widget_course_badge_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_widget_badge_normal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:text="第5-6节"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_badge_normal_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_course_title_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="软件工程"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/widget_text_primary"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/widget_course_info_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="14:00 - 15:40 · 知明 1-305"
                            android:textSize="11sp"
                            android:textColor="@color/widget_text_secondary"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>

                <!-- More Courses Notice -->
                <LinearLayout
                    android:id="@+id/widget_course_more"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/widget_course_more_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="+ 还有 1 节课程，点击查看完整课表"
                        android:textSize="10sp"
                        android:textColor="@color/widget_accent"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- Empty State Container -->
            <LinearLayout
                android:id="@+id/widget_empty_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_empty_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="今日课程已全部上完"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text_primary"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_empty_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="好好休息一下吧 · 点击查看完整课表"
                    android:textSize="11sp"
                    android:textColor="@color/widget_text_secondary"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
